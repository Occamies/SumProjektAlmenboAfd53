
@page "/"
@using FrontendBooking.Components
@using Radzen
@using Radzen.Blazor
@inject DialogService DialogService

<h1>Lokale</h1>

<RadzenScheduler TItem="Booking"
                 Data="@bookings"
                 StartProperty="Start"
                 EndProperty="End"
                 TextProperty="Title"
                 Height="600px"
                 @bind-SelectedDate="@selectedDate"
                 View="SchedulerView.Month"
                 SlotSelect="@OnSlotSelect"
                 AppointmentSelect="@OnAppointmentSelect">

    <RadzenMonthView />
    <RadzenWeekView />
    <RadzenDayView />

</RadzenScheduler>

@code {

    DateTime selectedDate = DateTime.Today;

    Booking? selectedBooking;

    // Eksempelbookinger i kalenderen
    List<Booking> bookings = new()
    {
        new Booking
        {
            Title = "Eksempelbooking",
            Start = DateTime.Today.AddDays(2).Date.AddHours(12),
            End = DateTime.Today.AddDays(3).Date.AddHours(11)
        },

        new Booking
        {
            Title = "Anden booking",
            Start = DateTime.Today.AddDays(5).Date.AddHours(12),
            End = DateTime.Today.AddDays(6).Date.AddHours(11)
        },

        new Booking
        {
            Title = "Weekendbooking",
            Start = DateTime.Today.AddDays(8).Date.AddHours(12),
            End = DateTime.Today.AddDays(10).Date.AddHours(11)
        }
    };

    // Når brugeren vælger en dato i kalenderen
    public async Task OnSlotSelect(SchedulerSlotSelectEventArgs args)
    {
        await OpenBookingDialog(args.Start.Date);
    }

    // Når brugeren klikker på en eksisterende booking
    public void OnAppointmentSelect(
        SchedulerAppointmentSelectEventArgs<Booking> args)
    {
        selectedBooking = args.Data;
    }

    // Åbner bookingdialogen
    public async Task OpenBookingDialog(DateTime date)
    {
        var result = await DialogService.OpenAsync<BookingDialog>(
            "Book fællesrum",
            new Dictionary<string, object?>
            {
                { "StartDate", date }
            },
            new DialogOptions
            {
                Width = "min(90vw, 600px)",
                CloseDialogOnOverlayClick = false
            }
        );

        // Modtag bookingoplysninger fra BookingDialog
        if (result is BookingDialog.BookingData bookingData)
        {
            if (!IsDateAvailable(bookingData.Start, bookingData.End))
            {
                await DialogService.Alert(
                    "Vælg venligst en anden dato.",
                    "Datoen er ikke ledig");

                return;
            }

            // Opret booking i kalenderen
            bookings.Add(new Booking
            {
                Title = bookingData.Title,
                Start = bookingData.Start,
                End = bookingData.End
            });

            // Opdater kalenderens dataliste
            bookings = bookings.ToList();
        }
    }

    private bool IsDateAvailable(DateTime start, DateTime end)
    {
        if (start.Date < DateTime.Today)
        {
            return false;
        }

        return !bookings.Any(booking =>
            start < booking.End &&
            end > booking.Start);
    }

    // Bookingmodel til kalenderen
    public class Booking
    {
        public string Title { get; set; } = "";
        public DateTime Start { get; set; }
        public DateTime End { get; set; }
    }
}
