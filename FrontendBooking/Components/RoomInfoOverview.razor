<RadzenCard>
    <RadzenText TextStyle="TextStyle.H5" Style="margin-bottom: 15px">Fællesrum</RadzenText>

    <RadzenDataGrid Data="@commonRooms" TItem="CommonRoomItem">
        <Columns>
            <RadzenDataGridColumn TItem="CommonRoomItem" Property="Name" Title="Fællesrum" />
            <RadzenDataGridColumn TItem="CommonRoomItem" Property="Tables" Title="Borde" />
            <RadzenDataGridColumn TItem="CommonRoomItem" Property="Chairs" Title="Stole" />
            <RadzenDataGridColumn TItem="CommonRoomItem" Property="Cutlery" Title="Bestik" />
            <RadzenDataGridColumn TItem="CommonRoomItem" Property="Games" Title="Spil" />
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    private List<CommonRoomItem> commonRooms = new()
    {
        new() { Name = "1E", Tables = 2, Chairs = 10, Cutlery = 10, Games = 2 },
        new() { Name = "1F", Tables = 2, Chairs = 10, Cutlery = 10, Games = 2 },
        new() { Name = "1G", Tables = 2, Chairs = 10, Cutlery = 10, Games = 2 },
        new() { Name = "1H", Tables = 2, Chairs = 10, Cutlery = 10, Games = 2 }
    };

    public class CommonRoomItem
    {
        public string Name { get; set; } = "";
        public int Tables { get; set; }
        public int Chairs { get; set; }
        public int Cutlery { get; set; }
        public int Games { get; set; }
    }
}