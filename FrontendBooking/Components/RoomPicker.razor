@using API.DTOs
@using FrontendBooking.Services
@inject SelectedRoomService RoomState
@inject HttpClient http

<div class="room-grid">
    @foreach (var room in RoomState.Rooms)
    {
        <RadzenButton Text="@room.Name"
                      ButtonStyle="@(room== RoomState.SelectedRoom ? ButtonStyle.Primary : ButtonStyle.Light)"
                      Click="@(() => Select(room))"
                      Style="height: 80px; font-size: 1.1em"/>
    }
</div>

<style>
    .room-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-top: 15px;
    }
</style>

@code {
    [Parameter] public EventCallback<string> OnRoomSelected { get; set; }

    private async Task Select(RoomDto room)
    {
        RoomState.SelectRoom(room);
        await RoomState.LoadReservationsByRoom(http);
        await OnRoomSelected.InvokeAsync(room.Name);
    }

    protected override async Task OnInitializedAsync()
    {
        await RoomState.LoadRoomes(http);
        
    }

}