<RadzenCard class="rules-card">
    <RadzenText TextStyle="TextStyle.H5" class="rules-title">
        Cleaning of the common room includes:
    </RadzenText>

    <ol class="rules-list">
        @foreach (var rule in rules)
        {
            <li class="rule">
                <span class="rule-heading">@rule.Title</span>
                <ul class="rule-points">
                    @foreach (var point in rule.Points)
                    {
                        <li>@point</li>
                    }
                </ul>
            </li>
        }
    </ol>
</RadzenCard>

<style>
    .rules-card {
        max-width: 800px;
        padding: 30px 40px;
        border-left: 5px solid var(--rz-primary);
    }

    .rules-title {
        margin-bottom: 20px;
        font-weight: 600;
    }

    .rules-list {
        padding-left: 20px;
        margin: 0;
    }

    .rule {
        margin-bottom: 18px;
    }

    .rule::marker {
        font-weight: 600;
        color: var(--rz-primary);
    }

    .rule-heading {
        font-weight: 600;
    }

    .rule-points {
        margin-top: 6px;
        padding-left: 20px;
        list-style-type: "–  ";
        color: #444;
    }

    .rule-points li {
        margin-bottom: 4px;
        line-height: 1.5;
    }
</style>

@code {
    private List<Rule> rules = new()
    {
        new("Washing kitchen utensils and tableware", new()
        {
            "Wash all borrowed kitchen utensils, plates, glasses, cutlery, etc.",
            "Make sure to empty the dishwasher if it is full and put all clean tableware back in its place."
        }),
        new("Cleaning surfaces", new()
        {
            "Wipe down all surfaces, including countertops, kitchen counters, dining tables, stovetops, ovens, etc., using a clean cloth and a suitable cleaning product. This also applies to the bathroom."
        }),
        new("Floor cleaning", new()
        {
            "Vacuum the floors in the common room and bathroom thoroughly to remove dirt, dust and crumbs.",
            "Wash the floors using floor cleaner and clean water to remove any stains or sticky areas."
        }),
        new("Closing windows", new()
        {
            "Make sure all windows are closed after use to prevent insects or moisture from entering."
        }),
        new("Removing perishable food", new()
        {
            "Check refrigerators and freezers for any leftover food and remove it.",
            "Clean up any spills or stains in the refrigerator to prevent unpleasant odours and bacterial growth."
        }),
        new("Emptying bins", new()
        {
            "Empty all bins in the common room and bathroom. Wipe them down if anything has spilled."
        }),
        new("Returning keys", new()
        {
            "Make sure the borrowed key to the common room is returned to the key box."
        }),
        new("Damaged equipment", new()
        {
            "Report any damaged equipment to the person in charge immediately."
        })
    };

    private record Rule(string Title, List<string> Points);
}