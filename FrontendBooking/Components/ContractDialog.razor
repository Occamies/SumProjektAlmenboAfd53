@using Radzen
@using Radzen.Blazor
@inject DialogService DialogService

<RadzenStack Gap="15px">

    <div style="max-height: 400px; overflow-y: auto; padding-right: 10px;">

        <p><b>1. Washing kitchen utensils and tableware</b></p>
        <ul>
            <li>Wash all borrowed kitchen utensils, plates, glasses, cutlery, etc.</li>
            <li>Make sure to empty the dishwasher if it is full and put all clean tableware back in its place.</li>
        </ul>

        <p><b>2. Cleaning surfaces</b></p>
        <ul>
            <li>Wipe down all surfaces, including countertops, kitchen counters, dining tables, stovetops, ovens, etc., using a clean cloth and a suitable cleaning product. This also applies to the bathroom.</li>
        </ul>

        <p><b>3. Floor cleaning</b></p>
        <ul>
            <li>Vacuum the floors in the common room and bathroom thoroughly to remove dirt, dust and crumbs.</li>
            <li>Wash the floors using floor cleaner and clean water to remove any stains or sticky areas.</li>
        </ul>

        <p><b>4. Closing windows</b></p>
        <ul>
            <li>Make sure all windows are closed after use to prevent insects or moisture from entering.</li>
        </ul>

        <p><b>5. Removing perishable food</b></p>
        <ul>
            <li>Check refrigerators and freezers for any leftover food and remove it.</li>
            <li>Clean up any spills or stains in the refrigerator to prevent unpleasant odours and bacterial growth.</li>
        </ul>

        <p><b>6. Emptying bins</b></p>
        <ul>
            <li>Empty all bins in the common room and bathroom. Wipe them down if anything has spilled.</li>
        </ul>

        <p><b>7. Returning keys</b></p>
        <ul>
            <li>Make sure the borrowed key to the common room is returned to the key box.</li>
        </ul>

        <p><b>8. Damaged equipment</b></p>
        <ul>
            <li>Report any damaged equipment to the person in charge immediately.</li>
        </ul>

    </div>

    <RadzenButton Text="Luk"
                  ButtonStyle="ButtonStyle.Light"
                  Click="@(() => DialogService.Close())" />

</RadzenStack>