
@using Radzen
@using Radzen.Blazor
@inject DialogService DialogService

<div class="equipment-dialog">

    <div class="equipment-header">
        <span>Items</span>
        <span>Antal</span>
        <span>Depositum</span>
        <span>Desc</span>
    </div>

    @foreach (var item in equipmentItems)
    {
        <div class="equipment-row">
            <span>@item.Name</span>

            <RadzenNumeric @bind-Value="item.Count"
                           Min="0"
                           Max=@item.Amount
                           Style="width: 65px" />
            <p>@item.Depositum kr</p>

            <p>@item.Description</p>
            
        </div>
    }

    <div class="equipment-buttons">
        <RadzenButton Text="Cancel"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@Cancel" />

        <RadzenButton Text="Add"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="@AddEquipment" />
    </div>

</div>

<style>
 
</style>

@code {
    private List<EquipmentItem> equipmentItems = new()
    {
        new EquipmentItem { Name = "Bord", Description = "Firkantet bord", Amount= 2, Depositum = 0},
        new EquipmentItem { Name = "Stol", Description = "Plastik", Amount = 12, Depositum = 0},
        new EquipmentItem { Name = "Grill", Description = "El-Grill Depositum", Amount = 1, Depositum = 500}
    };

    private void Cancel()
    {
        DialogService.Close();
    }

    private void AddEquipment()
    {
        DialogService.Close(equipmentItems);
    }

    public class EquipmentItem
    {
        public string Name { get; set; } = "";
        public int Count { get; set; }
        public string Description { get; set; } = "";
        public int Amount { get; set; } = 0;
        public int Depositum { get; set; } = 0;
    }
}
