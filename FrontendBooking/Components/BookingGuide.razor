<div class="guide">

    <RadzenCard class="guide-card">
        <RadzenText TextStyle="TextStyle.H5" class="guide-title">How to book the common room</RadzenText>
        <p class="guide-intro">
            You can read, how to book the common room, from start to finish. Just follow the steps.
        </p>

        <ol class="steps">
            @foreach (var step in steps)
            {
                <li class="step">
                    <span class="step-heading">@step.Title</span>
                    <p class="step-text">@step.Text</p>
                </li>
            }
        </ol>
    </RadzenCard>

    <RadzenCard class="guide-card">
        <RadzenText TextStyle="TextStyle.H6" class="guide-title">Nice to know</RadzenText>
        <ul class="tips">
            @foreach (var tip in tips)
            {
                <li>@tip</li>
            }
        </ul>
    </RadzenCard>

    <RadzenCard class="guide-card contact-card">
        <RadzenText TextStyle="TextStyle.H6" class="guide-title">Questions?</RadzenText>
        <p>
            If you cant find the answers you were looking for you can contact the board.
            <a href="mailto:post@almenbo-aarhus.dk">post@almenbo-aarhus.dk</a>
        </p>
    </RadzenCard>

</div>

<style>
    .guide {
        display: flex;
        flex-direction: column;
        gap: 25px;
        max-width: 800px;
    }

    .guide-card {
        padding: 30px 40px;
        border-left: 5px solid var(--rz-primary);
    }

    .guide-title {
        margin-bottom: 12px;
        font-weight: 600;
    }

    .guide-intro {
        color: #444;
        margin-bottom: 20px;
        line-height: 1.5;
    }

    .steps {
        padding-left: 20px;
        margin: 0;
    }

    .step {
        margin-bottom: 18px;
    }

    .step::marker {
        font-weight: 600;
        color: var(--rz-primary);
    }

    .step-heading {
        font-weight: 600;
    }

    .step-text {
        margin: 4px 0 0 0;
        color: #444;
        line-height: 1.5;
    }

    .tips {
        padding-left: 20px;
        list-style-type: "–  ";
        color: #444;
        margin: 0;
    }

    .tips li {
        margin-bottom: 6px;
        line-height: 1.5;
    }

    .contact-card {
        background-color: #f5f5fa;
    }

    .contact-card a {
        font-weight: 600;
        color: var(--rz-primary);
    }
</style>

@code {
    private List<GuideStep> steps = new()
    {
        new("Select your building",
            "If you live in a different building than the one displayed, you can change it under \"Change Building\" in the menu on the left."),

        new("Find the right common room",
            "Under \"Room Information\", you can see which common rooms are available and what they contain, including tables, chairs, cutlery and games."),

        new("Select a date and time",
            "Go to \"Common Room\" and find the day you want to book in the calendar. Click on an available time slot to start your booking."),

        new("Complete your booking",
            "A window will open where you can enter your booking details. Make sure the date and time are correct."),

        new("Add extra equipment (optional)",
            "If you need equipment such as a barbecue or projector, you can add it to your booking. Select the quantity and add a comment if needed. See prices and deposit information under \"Extra Equipment\"."),

        new("Accept the contract",
            "Read through the rental contract and the common room rules, then accept them digitally. Your booking is only completed once the contract has been accepted."),

        new("Receive your access code",
            "Once your booking is confirmed, you will receive an access code for the door. The code will only work during your booked time slot."),

        new("Clean up after yourself",
            "When you are finished, you must clean the room according to the guidelines under \"Rules\". Remember to close the windows and return any borrowed keys.")};

    private List<string> tips = new()
    {
        "Book in advance – popular days such as weekends and public holidays fill up quickly.",
        "Deposits for extra equipment will be refunded once the equipment has been returned in good condition.",
        "Any damaged furniture or equipment must be reported to the board immediately."
    };

    private record GuideStep(string Title, string Text);
}