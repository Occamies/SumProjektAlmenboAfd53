@using System.Net
@using API.DTOs
@using Radzen
@using Radzen.Blazor
@inject DialogService DialogService
@inject HttpClient http

<RadzenStack Gap="15px">

    <RadzenText Text="@Reservation.Name" TextStyle="TextStyle.H5" />

    <p>Start: @Reservation.StartDate.ToString("dd-MM-yyyy HH:mm")</p>
    <p>End: @Reservation.EndDate.ToString("dd-MM-yyyy HH:mm")</p>

    <RadzenText Text="Enter the password to cancel the booking." />

    <RadzenPassword @bind-Value="reservationCode"
                    Placeholder="Password"
                    Style="width: 100%" />

    @if (errorMessage is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger"
                     AllowClose="false"
                     ShowIcon="false">
            @errorMessage
        </RadzenAlert>
    }

    <RadzenStack Orientation="Orientation.Horizontal" Gap="10px">
        <RadzenButton Text="Cancel booking"
                      ButtonStyle="ButtonStyle.Danger"
                      Disabled="@isBusy"
                      Click="@Cancel" />

        <RadzenButton Text="Close"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@(() => DialogService.Close(false))" />
    </RadzenStack>

</RadzenStack>

@code {

    //Receives the reservation from the parent component.
    [Parameter, EditorRequired] public ReservationDto Reservation { get; set; } = default!;

    string reservationCode = "";
    string? errorMessage;
    bool isBusy;

    //Handles the cancellation of a reservation.
    private async Task Cancel()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(reservationCode))
        {
            errorMessage = "You need to write a password";
            return;
        }
        //Indikere at en request er igang
        isBusy = true;

        try
        {
            //Viser en cancelrequest til API med reservation id og kode
        var response = await http.PutAsJsonAsync(
            $"api/reservation/{Reservation.Id}/cancel", 
            new CancelReservationDto { Code = reservationCode });

            if (response.IsSuccessStatusCode)
            {
                DialogService.Close(true);
                return;
            }
            //Viser fejl besked baseret på response status kode
            errorMessage = response.StatusCode switch
            {
                HttpStatusCode.Forbidden or HttpStatusCode.BadRequest => "Wront password",
                HttpStatusCode.NotFound => "The reservations isint found",
                _ => "Something went wrong."
            };
        }
        //Hvis api ikke kan kontakte server
        catch (HttpRequestException)
        {
            errorMessage = "No server contact.";
        }
        finally
        {
            isBusy = false;
        }
    }
}