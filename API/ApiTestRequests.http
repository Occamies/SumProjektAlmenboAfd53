### 1. GET - Hent alle Items
GET {{host}}/api/Item
Accept: application/json


### 2. POST - Opret Item
POST {{host}}/api/Item
Content-Type: application/json

{
  "name": "Fælleslokale A",
  "location": "Bygning 1"
}


### 3. GET - Hent Item efter ID
GET {{host}}/api/Item/{{itemId}}
Accept: application/json


### 4. PUT - Opdater Item
PUT {{host}}/api/Item/{{itemId}}
Content-Type: application/json

{
  "name": "Fælleslokale B",
  "location": "Bygning 2"
}


### 5. GET - Kontroller opdatering
GET {{host}}/api/Item/{{itemId}}
Accept: application/json

####################################################################################

### 1. GET - Hent alle reservationer
GET {{host}}/api/Reservation
Accept: application/json


### 2 POST - Opret reservation
POST {{host}}/api/Reservation
Content-Type: application/json

{
  "itemId": "{{itemIdTilReservation}}",
  "personId": "{{personIdTilReservation}}",
  "startDate": "2026-12-24T12:00:00Z",
  "endDate": "2026-12-26T11:00:00Z"
}


### 3 GET - Hent reservation efter ID
GET {{host}}/api/Reservation/{{reservationId}}
Accept: application/json




### 4. POST - Test dobbeltbooking
# 409 Conflict
POST {{host}}/api/Reservation
Content-Type: application/json

{
  "itemId": "{{itemIdTilReservation}}",
  "personId": "{{personIdTilReservation}}",
  "startDate": "2026-12-15T11:00:00Z",
  "endDate": "2026-12-15T13:00:00Z"
}


### 5 POST - Test ugyldigt datointerval
# 400 Bad Request
POST {{host}}/api/Reservation
Content-Type: application/json

{
  "itemId": "{{itemIdTilReservation}}",
  "personId": "{{personIdTilReservation}}",
  "startDate": "2026-12-15T14:00:00Z",
  "endDate": "2026-12-15T10:00:00Z"
}


### 6 POST - Test manglende Item
# 404 Not Found
POST {{host}}/api/Reservation
Content-Type: application/json

{
  "itemId": "00000000-0000-0000-0000-000000000000",
  "personId": "{{personIdTilReservation}}",
  "startDate": "2026-12-16T10:00:00Z",
  "endDate": "2026-12-16T14:00:00Z"
}


### 7 PUT - Annuller med forkert kode
# 400 Bad Request
PUT {{host}}/api/Reservation/{{reservationId}}/cancel
Content-Type: application/json

{
  "code": "forkert"
}


### 8. PUT - Annuller med korrekt testkode
# Din Reservation-klasse bruger midlertidigt "1234". - obs på at rette det
# Forventet: 204 No Content
PUT {{host}}/api/Reservation/{{reservationId}}/cancel
Content-Type: application/json

{
  "code": "1234"
}


### 9 GET - Kontroller reservation efter annullering
GET {{host}}/api/Reservation/{{reservationId}}
Accept: application/json