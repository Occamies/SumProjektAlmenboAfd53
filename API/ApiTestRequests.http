@host=http://localhost:5108
@personId=eb6dfaab-c94b-45d8-85f3-60029be69d8d
@lokaleId=9ec494cd-678e-4f81-9930-39131f4d3e69
@udstyrId=6f508495-b7b4-4c2e-b554-b51acab071c8
@contracId=50114a4a-dbbe-44e1-8e61-f8af2cbc3a74
@itemId=81ec8adc-2872-4c48-ac36-94516971f5bc
@personIdTilReservation=d5462475-9402-4611-8a68-37ab935bd647
@itemIdTilReservation=9ec494cd-678e-4f81-9930-39131f4d3e69
@reservationId=12859f7f-7538-40cb-b820-ec707676de56

### Hent alle personer fra PostgreSQL
GET {{host}}/api/person
Accept: application/json

### Opret person i PostgreSQL
POST {{host}}/api/person
Content-Type: application/json

{
  "name": "Test Person",
  "email": "test@example.com",
  "address": "Testvej 10",
  "phone": "12345678"
}

### Hent en bestemt person fra PostgreSQL
GET {{host}}/api/person/{{personId}}
Accept: application/json

### Opdater eksisterende person
PUT {{host}}/api/person/{{personId}}
Content-Type: application/json

{
  "name": "Opdateret Test Person",
  "email": "opdateret@example.com",
  "address": "Ny Testvej 20",
  "phone": "87654321"
}

### Hent den opdaterede person
GET {{host}}/api/person/{{personId}}
Accept: application/json

### Slet en person fra PostgreSQL
DELETE {{host}}/api/person/{{personId}}

### Kontrollér at personen er slettet
GET {{host}}/api/person/{{personId}}
Accept: application/json

####################################################################################

### Hent alle lokaler fra PostgreSQL
GET {{host}}/api/room
Accept: application/json

### Opret et lokale
POST {{host}}/api/room
Content-Type: application/json

{
  "name": "Fælleslokale 2",
  "location": "Stueetagen"
}

### Hent et bestemt lokale ud fra ID
GET {{host}}/api/room/{{lokaleId}}
Accept: application/json

### Opdater et eksisterende lokale
PUT {{host}}/api/room/{{lokaleId}}
Content-Type: application/json

{
  "name": "Stort fælleslokale",
  "location": "1. sal"
}

### Slet et lokale
DELETE {{host}}/api/room/{{lokaleId}}

####################################################################################

### 1. Hent alt ekstraudstyr
GET {{host}}/api/extraequipment
Accept: application/json


### 2. Opret ekstraudstyr
POST {{host}}/api/extraequipment
Content-Type: application/json

{
  "name": "Projektor",
  "location": "Depot"
}


### 3. Hent ekstraudstyr via ID
# Erstat GUID med ID fra POST-svaret
GET {{host}}/api/extraequipment/{{udstyrId}}
Accept: application/json


### 4. Opdater ekstraudstyr
# Erstat GUID med ID fra POST-svaret
PUT {{host}}/api/extraequipment/{{udstyrId}}
Content-Type: application/json

{
  "name": "4K Projektor",
  "location": "Fælleslokale"
}


### 5. Slet ekstraudstyr
# Erstat GUID med ID fra POST-svaret
DELETE {{host}}/api/extraequipment/{{udstyrId}}

